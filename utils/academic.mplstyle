# Researcher skill fallback academic Matplotlib style.
# Copy into the project and adapt when a journal/thesis style exists.

figure.figsize: 6.8, 4.2
figure.dpi: 120
savefig.bbox: tight
savefig.pad_inches: 0.05

font.size: 9
axes.labelsize: 9
axes.titlesize: 10
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8

axes.linewidth: 0.8
lines.linewidth: 1.4
lines.markersize: 4.0

xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True
xtick.major.width: 0.7
ytick.major.width: 0.7
xtick.minor.width: 0.5
ytick.minor.width: 0.5

legend.frameon: False
axes.grid: False

pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: none
